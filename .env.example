# Chain config
CHAIN_NAME=base

# PostgreSQL
POSTGRES_DSN=postgres://indexer:indexer@localhost:5432/indexing?sslmode=disable

# Indexer
INDEXER_BLOCK_BATCH_SIZE=100
INDEXER_TIP_FOLLOWING_ENABLED=true
INDEXER_RETRY_AFTER_RECEIPTS_NULL=1s
INDEXER_SLEEP_AFTER_CATCHUP_BATCH=1s
INDEXER_NEW_BLOCK_WAITING_TIME=500ms
INDEXER_POLL_INTERVAL_WHEN_CONFIRMED=5s
INDEXER_RETRY_AFTER_FAILED=5s

# Webhook consumer
WEBHOOK_URL=
WEBHOOK_SECRET=
CONSUMER_ID=consumer-1
